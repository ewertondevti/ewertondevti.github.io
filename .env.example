# For a repository site use /repository-name. Leave empty for an account root site.
NEXT_PUBLIC_BASE_PATH=
# Set the real production origin to enable canonical URLs, sitemap and social URLs.
NEXT_PUBLIC_SITE_URL=
# Optional verified public contact details. Empty values hide the corresponding links.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
